# Salin file ini menjadi .env lalu isi nilai aslinya. JANGAN commit file .env ke git.

# Port server Express (Sesuai proxy Vite di client/vite.config.js)
PORT=5001

# Koneksi Database PostgreSQL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitara_db?schema=public

# Rahasia JWT untuk Auth P1
JWT_SECRET=rahasia_vitara_jwt_super_aman_2024

# API key Gemini dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# (Opsional) Override nama model. Default: gemini-3.8-flash
# Alternatif aktif lain: gemini-3.6-flash, gemini-2.5-flash
# PENTING: gemini-2.0-flash SUDAH DI-PENSIUNKAN Google (404 retired).
GEMINI_MODEL=

# (Opsional) Daftar asal (Origin) frontend yang diizinkan, pisah koma.
# Kosongkan = terbuka seperti sebelumnya (default lokal). Contoh produksi:
# ALLOWED_ORIGIN=https://vitara-gig.vercel.app

# OAuth Google (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI harus sama persis dengan OAUTH_REDIRECT_URI di bawah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5001/api/auth/oauth/google/callback
# Produksi (Railway): pakai domain frontend Vercel agar cookie state tetap
# satu host lewat rewrite /api:
# OAUTH_REDIRECT_URI=https://vitara-gig.vercel.app/api/auth/oauth/google/callback
# CLIENT_URL=https://vitara-gig.vercel.app
# URL frontend untuk redirect balik setelah login Google
CLIENT_URL=http://localhost:5173

# Web Push (Sprint 6). Generate dengan: npx web-push generate-vapid-keys
# Isi di Railway sebagai VAPID_PUBLIC, VAPID_PRIVATE, VAPID_SUBJECT.
# Tanpa ketiga nilai ini, scheduler push tidak aktif.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@vitara.id

# Reset kata sandi lewat email (Resend). Opsional; tanpa key, tautan
# reset hanya dicatat di log server saat mode non-produksi.
RESEND_API_KEY=
EMAIL_FROM=VITARA <onboarding@resend.dev>
