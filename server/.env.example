# Salin file ini menjadi .env lalu isi nilai aslinya. JANGAN commit file .env ke git.

# Port server Express
PORT=5000

# Koneksi Database PostgreSQL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitara_db?schema=public

# Rahasia JWT untuk Auth P1
JWT_SECRET=rahasia_vitara_jwt_super_aman_2024

# API key Gemini dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# (Opsional) Override nama model. Default: gemini-3.8-flash
# Alternatif aktif lain: gemini-3.6-flash, gemini-2.5-flash
# PENTING: gemini-2.0-flash SUDAH DI-PENSIUNKAN Google (404 retired).
GEMINI_MODEL=
