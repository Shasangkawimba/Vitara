// Prisma Schema untuk VITARA (Virtual Assistant for Tracking and Recovery)
// Dikelola secara mutlak oleh P1 (Auth & Work-Health Logger)
// Sesuai dengan spesifikasi AGENTS.md dan P1_PRIVATE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model Pengguna (User)
// Menyimpan kredensial autentikasi dan profil dasar pekerja
// Catatan: username, phone, email, dan password nullable agar:
// - akun lama (hanya punya phone) tetap bisa login via nomor telepon,
// - akun Google tidak punya password/nomor telepon sampai diisi
//   sendiri lewat halaman Profil.
// authProvider + providerId menandai asal akun ("local" | "google").
model User {
  id           String    @id @default(cuid())
  username     String?   @unique
  phone        String?   @unique
  email        String?   @unique
  password     String?
  name         String
  occupation   String?
  photo        String?
  authProvider String    @default("local")
  providerId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workLogs       WorkLog[]
  aiInteractions AiInteraction[]
  reminders      Reminder[]
  auditLogs      AuditLog[]
  pushSubscriptions PushSubscription[]
  passwordResets PasswordResetToken[]

  @@unique([authProvider, providerId])
}

// Model Pencatatan Kerja & Kesehatan (WorkLog)
// Menyimpan log harian terkait jam kerja, pendapatan, dan keluhan fisik
model WorkLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workHours Int
  income    Int?
  symptoms  String[] // Array keluhan fisik (contoh: ["pegal linu", "sakit pinggang"])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Model Interaksi AI (AiInteraction)
// Menyimpan percakapan konsultasi dengan Ergo-Coach AI (Dibutuhkan oleh P2)
model AiInteraction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pesanUser   String
  responsAi   Json     // Format JSON: { analisis, rencana_pemulihan, saran_otc, peringatan, disclaimer }
  isEmergency Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Model Pengingat Kesehatan. Sebelumnya tersimpan di memori dan bersama
// antaruser; sekarang per-user dan ikut terhapus saat akun dihapus.
model Reminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  time      String
  type      String   @default("CUSTOM")
  days      String[]
  notes     String?
  isActive  Boolean   @default(true)
  lastSentAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// Jejak aksi sensitif (login, daftar, ganti sandi, hapus akun).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  aksi      String
  detail    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Langganan Web Push per perangkat. Dipakai scheduler server untuk
// mengirim notifikasi walau tab browser tertutup.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Token reset kata sandi sekali pakai. Yang disimpan hanya hash token,
// bukan token mentah, dan tautannya berlaku 30 menit.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

